<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Diorama.OpenFromArchive"
        Title="OpenFromArchive"
        MaxHeight="800">
  <StackPanel>
    <TextBox x:Name="SearchBox" Text="{Binding Search, Mode=TwoWay}"></TextBox>
    <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected, Mode=TwoWay}" MaxHeight="600" DoubleTapped="FilesList_DoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Path}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</Window>
