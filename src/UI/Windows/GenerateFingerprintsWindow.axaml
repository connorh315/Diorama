<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Diorama.GenerateFingerprintsWindow">
  <StackPanel Spacing="10" Width="500">
    <TextBlock FontSize="30" HorizontalAlignment="Center">Generating...</TextBlock>
    <TextBlock HorizontalAlignment="Center">
      <Run>Processed</Run>
      <Run Text="{Binding Progress}" />
      <Run>files</Run>
    </TextBlock>
    <TextBlock Text="{Binding Status}" />
    <Button Command="{Binding CancelCommand}" HorizontalAlignment="Center">Cancel</Button>
  </StackPanel>
</Window>
