<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Diorama.SettingsWindow"
        Title="SettingsWindow"
        xmlns:controls="using:Diorama">
  <StackPanel Width="400" Margin="5">
    <controls:PropertyEditor Property="DatLocation" />
    <Button Click="SaveSettings_Click" HorizontalAlignment="Center">Save Settings</Button>
  </StackPanel>
</Window>
