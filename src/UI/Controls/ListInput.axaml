<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Diorama">

  <!--
    Additional resources 
    Using Control Themes:
         https://docs.avaloniaui.net/docs/basics/user-interface/styling/control-themes
    Using Theme Variants:
         https://docs.avaloniaui.net/docs/guides/styles-and-resources/how-to-use-theme-variants
  -->
  
  <Design.PreviewWith>
    <StackPanel Width="400" Spacing="10">      
        <StackPanel Background="{DynamicResource SystemRegionBrush}">
          <controls:ListInput />
        </StackPanel>
    </StackPanel>
  </Design.PreviewWith>
 
  <ControlTheme x:Key="{x:Type controls:ListInput}" TargetType="controls:ListInput">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
          </Grid.ColumnDefinitions>

          <TextBlock
              Grid.Column="0"
              Text="{TemplateBinding InputLabel}"
              VerticalAlignment="Center" />

          <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PART_Button" VerticalAlignment="Stretch" Width="{Binding Bounds.Height, RelativeSource={RelativeSource Self}}">
              <Path
                Width="10"
                Height="6"
                Data="M 1,1 L 5,5 L 9,1"
                Stroke="{DynamicResource ComboBoxDropDownGlyphForeground}"
                StrokeThickness="1.5"
                StrokeLineCap="Round"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Button>
            <TextBox Grid.Column="1" Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
            <Button Grid.Column="2" 
                    x:Name="PART_Unlink" 
                    VerticalAlignment="Stretch" 
                    VerticalContentAlignment="Center" 
                    HorizontalContentAlignment="Center" 
                    Width="{Binding Bounds.Height, RelativeSource={RelativeSource Self}}"
                    ToolTip.Tip="Unlink selection"
                    IsVisible="{TemplateBinding CanBeNull}">X</Button>
          </Grid>
          
          <Popup
              x:Name="PART_Popup"
              PlacementTarget="{Binding #PART_Button}"
              Placement="AnchorAndGravity"
              PlacementAnchor="BottomLeft"
              PlacementGravity="BottomRight"
              IsLightDismissEnabled="True"
              MaxHeight="500">

            <Border>
              <ListBox
                  x:Name="PART_List"
                  ItemsSource="{Binding Items,
                    RelativeSource={RelativeSource TemplatedParent}}">

                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                  <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="DodgerBlue" />
                  </Style>
                </ListBox.Styles>

                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Popup>
        </Grid>

      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
