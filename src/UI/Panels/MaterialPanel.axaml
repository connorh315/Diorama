<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Diorama.MaterialPanel"
             xmlns:controls="using:Diorama"
             xmlns:editor="using:Diorama.Editor">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="5" Spacing="2">
      <controls:PropertyEditor Property="Name" />
      <controls:ColorInput InputLabel="Material Primary Colour" Color="{Binding Colour1, Mode=TwoWay}" />
      <Expander Header="Textures" HorizontalAlignment="Stretch">
        <StackPanel Spacing="5">
          <controls:PropertyEditor Property="NumAlphaLayers" />
          <controls:PropertyEditor Property="VertLayer1Albedo" />
          <controls:PropertyEditor Property="VertLayer2Albedo" />
          <controls:PropertyEditor Property="VertLayer3Albedo" />
          <controls:PropertyEditor Property="IgnoreVertexOpacity" />
          <controls:CheckboxInput InputLabel="Per Layer UV Scale" Value="{Binding PerLayerScale, Mode=TwoWay}"/>
          <controls:TextureSlotControl
            InputLabel="Diffuse 0"
            Texture="{Binding Diffuse0}"
            SelectedSet="{Binding Diffuse0UVSet}">
            
            <StackPanel Spacing="5">
              <controls:PropertyEditor Property="PerLayerUVScale1" />
              <controls:PropertyEditor Property="DiffuseLayerBlend" />
            </StackPanel>
          </controls:TextureSlotControl>
          <controls:TextureSlotControl
            InputLabel="Diffuse 1"
            Texture="{Binding Diffuse1}"
            SelectedSet="{Binding Diffuse1UVSet}">

            <StackPanel Spacing="5">
              <controls:PropertyEditor Property="PerLayerUVScale2" />
              <controls:PropertyEditor Property="Diffuse1LayerBlend" />
            </StackPanel>
          </controls:TextureSlotControl>
          <controls:TextureSlotControl
            InputLabel="Normal 0"
            Texture="{Binding Normal0}"
            SelectedSet="{Binding Normal0UVSet}">

            <StackPanel Spacing="5">
              <controls:PropertyEditor Property="Normal0LayerBlend" />
              <controls:PropertyEditor Property="KNormal0" />
              <controls:PropertyEditor Property="Normal0Format" />
            </StackPanel>
          </controls:TextureSlotControl>
          <controls:TextureSlotControl
            InputLabel="Normal 1"
            Texture="{Binding Normal1}"
            SelectedSet="{Binding Normal1UVSet}">

            <StackPanel Spacing="5">
              <controls:PropertyEditor Property="Normal1LayerBlend" />
              <controls:PropertyEditor Property="KNormal1" />
              <controls:PropertyEditor Property="Normal1Format" />
            </StackPanel>
          </controls:TextureSlotControl>
          <controls:TextureSlotControl
            InputLabel="Specular 0"
            Texture="{Binding Specular0}"
            SelectedSet="{Binding Specular0UVSet}">

            <StackPanel Spacing="5">
            </StackPanel>
          </controls:TextureSlotControl>
          <controls:TextureSlotControl
            InputLabel="Environment Map"
            Texture="{Binding EnvMap}"
            SelectedSet="{Binding Specular0UVSet}">

            <StackPanel Spacing="5">
            </StackPanel>
          </controls:TextureSlotControl>
        </StackPanel>
      </Expander>

      <controls:PropertyEditor Property="Colour" />


      <controls:PropertyEditor Property="Glow" />
      <controls:PropertyEditor Property="KGlow" />

      <controls:PropertyEditor Property="Substance" />
      <controls:PropertyEditor Property="SubstanceFactor" />

      <controls:PropertyEditor Property="Reflection" />
      <controls:PropertyEditor Property="Reflectivity" />


      <controls:PropertyEditor Property="Roughness" />
      <controls:PropertyEditor Property="BaseRoughness" />
      <controls:PropertyEditor Property="RoughnessMod" />

      <controls:PropertyEditor Property="Refraction" />
      <controls:PropertyEditor Property="RefractiveIndex" />
      <controls:PropertyEditor Property="RefractiveThickness" />
      <controls:PropertyEditor Property="BlendMode" />
      <controls:PropertyEditor Property="AlphaTest" />
      <controls:PropertyEditor Property="AlphaRef" />
      <controls:PropertyEditor Property="CanAlphaBlend" />
      <controls:PropertyEditor Property="ShadowImpostor" />
      <controls:PropertyEditor Property="BitangentFlip" />
      <controls:PropertyEditor Property="BakedLighting" />
      <controls:PropertyEditor Property="UVAnimation" />
      <controls:PropertyEditor Property="GenerateCubemap" />
      <controls:PropertyEditor Property="ForceDefaultCubemap" />
      <controls:PropertyEditor Property="Debug" />
      <controls:PropertyEditor Property="Dump" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
