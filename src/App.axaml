<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Diorama.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <Style Selector="FlyoutPresenter.texturePicker">
          <Setter Property="MaxWidth" Value="850"/>
        </Style>
    </Application.Styles>
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceInclude Source="UI/Controls/SceneHierarchy.axaml"/>
          <ResourceInclude Source="UI/Controls/Vec3Input.axaml"/>
          <ResourceInclude Source="UI/Controls/ColorInput.axaml"/>
          <ResourceInclude Source="UI/Controls/ListInput.axaml"/>
          <ResourceInclude Source="UI/Controls/TextInput.axaml"/>
          <ResourceInclude Source="UI/Controls/TextureInput.axaml"/>
          <ResourceInclude Source="UI/Controls/TextureUVInput.axaml"/>
          <ResourceInclude Source="UI/Controls/CheckboxInput.axaml"/>
          <ResourceInclude Source="UI/Controls/EnumInput.axaml"/>
          <ResourceInclude Source="UI/Controls/TextureAnimInput.axaml"/>
          <ResourceInclude Source="UI/Controls/TransformInput.axaml"/>

          <ResourceInclude Source="UI/Controls/TextureSlotControl.axaml"/>

          <ResourceInclude Source="UI/Panels/InspectorPanel.axaml"/>
          <ResourceInclude Source="UI/Panels/RenderOptionsPanel.axaml"/>

          <ResourceInclude Source="UI/Panels/Inspectors/GeometryInspector.axaml"/>
          <ResourceInclude Source="UI/Panels/Inspectors/PoIInspector.axaml"/>
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </Application.Resources>
</Application>